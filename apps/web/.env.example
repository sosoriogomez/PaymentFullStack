# Mismo origen: en local Vite reenvía /api al backend (vite.config.ts); en AWS lo hace CloudFront.
VITE_API_BASE_URL=/api
# URL UAT *sandbox* de la pasarela (host con prefijo api-sandbox), usada solo para tokenizar la tarjeta.
VITE_PG_BASE_URL=
# Llave pública de la pasarela (pública por diseño).
VITE_PG_PUBLIC_KEY=
