{
  "name": "@checkout/api",
  "version": "0.1.0",
  "private": true,
  "description": "Checkout API: NestJS, arquitectura hexagonal y Railway Oriented Programming",
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "depcruise": "depcruise src --config .dependency-cruiser.cjs",
    "test": "jest --coverage",
    "test:unit": "jest --selectProjects unit",
    "test:int": "jest --selectProjects integration",
    "test:e2e": "jest --selectProjects e2e",
    "db:migrate": "nest build && node dist/database/cli.js migrate",
    "db:reset": "nest build && node dist/database/cli.js reset",
    "build:lambda": "nest build && node scripts/bundle-lambda.mjs",
    "smoke:lambda": "node scripts/smoke-lambda-bundle.mjs",
    "pg:smoke": "nest build && node scripts/pg-smoke.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.2.6",
    "@testcontainers/postgresql": "^11.14.0",
    "@types/aws-lambda": "^8.10.163",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.4",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "dependency-cruiser": "^17.4.3",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "globals": "^17.12.0",
    "jest": "^30.5.2",
    "supertest": "^7.3.0",
    "testcontainers": "^11.14.0",
    "ts-jest": "^29.4.14",
    "typescript": "~5.9",
    "typescript-eslint": "^8.70.1"
  },
  "dependencies": {
    "@aws-sdk/client-secrets-manager": "^3.1141.0",
    "@aws-sdk/client-ssm": "^3.1141.0",
    "@codegenie/serverless-express": "^4.17.1",
    "@nestjs/common": "^11.2.6",
    "@nestjs/core": "^11.2.6",
    "@nestjs/platform-express": "^11.2.6",
    "@nestjs/swagger": "^11.4.7",
    "@nestjs/throttler": "^6.7.1",
    "@nestjs/typeorm": "^11.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.4",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "nestjs-pino": "^4.6.1",
    "pg": "^8.23.0",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^0.3.31",
    "ulid": "^3.0.2",
    "zod": "^4.6.5"
  }
}
