# Copia este archivo a .env para desarrollo local. Nunca versiones .env.
NODE_ENV=development
APP_ENV=local
PORT=3000
LOG_LEVEL=debug
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Base de datos local (docker compose up -d db)
DATABASE_URL=postgres://checkout:checkout@localhost:5432/checkout
DB_POOL_MAX=2

# Pasarela de pagos: URL UAT de *sandbox* (host con prefijo api-sandbox) y llaves de prueba.
PG_BASE_URL=
PG_PUBLIC_KEY=
PG_PRIVATE_KEY=
PG_INTEGRITY_SECRET=
PG_EVENTS_SECRET=
PG_POST_TIMEOUT_MS=8000
PG_GET_TIMEOUT_MS=4000
PG_GET_MAX_RETRIES=2
PG_DEADLINE_MS=12000
ACCEPTANCE_CACHE_TTL_SECONDS=300

# Pricing (centavos de COP)
BASE_FEE_IN_CENTS=300000
DELIVERY_FEE_IN_CENTS=1000000
CURRENCY=COP

# Reconciliación programada
RECONCILE_MIN_AGE_SECONDS=60
RECONCILE_BATCH_SIZE=25
PENDING_EXPIRATION_MINUTES=15
