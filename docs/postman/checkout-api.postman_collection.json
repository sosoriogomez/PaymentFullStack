              }
            ],
            "url": "{{baseUrl}}/transactions",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"productId\": \"{{productId}}\",\n  \"quantity\": 1,\n  \"customerId\": \"{{customerId}}\",\n  \"delivery\": {\n    \"recipientName\": \"Ana Pérez\",\n    \"recipientPhone\": \"3001234567\",\n    \"addressLine1\": \"Cra 43A # 1-50\",\n    \"addressLine2\": \"Apto 301\",\n    \"city\": \"Medellín\",\n    \"region\": \"Antioquia\",\n    \"country\": \"CO\",\n    \"postalCode\": \"050021\"\n  },\n  \"payment\": {\n    \"cardToken\": \"{{cardToken}}\",\n    \"installments\": 1,\n    \"acceptanceToken\": \"{{acceptanceToken}}\",\n    \"acceptPersonalAuth\": \"{{personalDataToken}}\"\n  },\n  \"amountInCents\": 1\n}",
              "options": {
